import re
from datetime import datetime, timedelta, timezone
from urllib.parse import urljoin
from calibre.web.feeds.news import BasicNewsRecipe

SGT = timezone(timedelta(hours=8))


class ChannelNewsAsia(BasicNewsRecipe):
    title = 'Channel NewsAsia'
    oldest_article = 1.5
    max_articles_per_feed = 15
    auto_cleanup = False
    language = 'en_SG'
    scale_news_images_to_device = True
    compress_news_images = True
    compress_news_images_max_size = 35

    feeds = [
        ('World', 'https://www.channelnewsasia.com/api/v1/rss-outbound-feed?_format=xml&category=6311'),
        ('Singapore', 'https://www.channelnewsasia.com/api/v1/rss-outbound-feed?_format=xml&category=10416'),
        ('Business', 'https://www.channelnewsasia.com/api/v1/rss-outbound-feed?_format=xml&category=6936'),
        ('Asia', 'https://www.channelnewsasia.com/api/v1/rss-outbound-feed?_format=xml&category=6511'),
    ]

    def __init__(self, *args, **kwargs):
        now_sgt = datetime.now(SGT)
        self.timefmt = now_sgt.strftime(' [%a, %d %b %Y]')
        super().__init__(*args, **kwargs)

    def get_browser(self):
        br = super().get_browser()
        br.addheaders += [('Referer', 'https://www.channelnewsasia.com/')]
        return br

    def _clean_img_url(self, raw_url, is_srcset=False):
        if not raw_url or not isinstance(raw_url, str):
            return None
        url = raw_url.strip()
        if is_srcset:
            candidates = re.split(r'\s+\d+[wx](?:,\s*|$)', url)
            url = candidates[0].strip() if candidates and candidates[0].strip() else url.split()[0]
        if not url or url.startswith('data:'):
            return None
        lower = url.lower()
        skip_terms = (
            'logo', 'icon', 'avatar', 'placeholder', '.svg',
            '1x1', 'pixel', 'social_share', 'default-og', 'cna-default'
        )
        if any(skip in lower for skip in skip_terms):
            return None
        return urljoin('https://www.channelnewsasia.com/', url)

    def _extract_headline(self, soup):
        h1 = soup.find('h1')
        if h1:
            txt = ' '.join(h1.get_text().split()).strip()
            if txt:
                return txt
        og_title = soup.find('meta', property='og:title')
        if og_title and og_title.get('content'):
            txt = ' '.join(og_title['content'].split()).strip()
            txt = re.sub(r'\s*[-|]\s*(CNA|Channel NewsAsia)\s*$', '', txt, flags=re.IGNORECASE)
            if txt:
                return txt
        title_tag = soup.find('title')
        if title_tag:
            txt = ' '.join(title_tag.get_text().split()).strip()
            txt = re.sub(r'\s*[-|]\s*(CNA|Channel NewsAsia)\s*$', '', txt, flags=re.IGNORECASE)
            if txt:
                return txt
        return None

    def _normalize_media(self, container, soup):
        for picture in container.find_all('picture'):
            img = picture.find('img')
            source = picture.find('source')
            clean_url = None
            if source and source.get('srcset'):
                clean_url = self._clean_img_url(source['srcset'], is_srcset=True)
            if not clean_url and img:
                for attr, is_ss in (('data-src', False), ('data-original', False), ('srcset', True), ('src', False)):
                    if img.get(attr):
                        clean_url = self._clean_img_url(img[attr], is_srcset=is_ss)
                        if clean_url:
                            break
            if clean_url:
                picture.replace_with(soup.new_tag('img', src=clean_url))
            else:
                picture.decompose()

        for img in container.find_all('img'):
            clean_url = None
            for attr, is_ss in (('data-src', False), ('data-original', False), ('srcset', True), ('src', False)):
                if img.get(attr):
                    clean_url = self._clean_img_url(img[attr], is_srcset=is_ss)
                    if clean_url:
                        break
            if clean_url:
                img.attrs = {'src': clean_url}
            else:
                img.decompose()

    def _is_noise_block(self, tag):
        noise_keywords = (
            'related', 'recommended', 'card', 'teaser',
            'newsletter', 'advertisement', 'promo', 'social', 'share'
        )
        for parent in [tag] + list(tag.parents):
            if parent.name in ('nav', 'footer', 'aside', 'header'):
                return True
            classes = ' '.join(parent.get('class', [])).lower()
            if any(k in classes for k in noise_keywords):
                return True
        return False

    def _is_boilerplate_text(self, text):
        lower = text.lower()
        phrases = (
            'subscribe to our',
            'download our app',
            'get our pick of top stories',
            'sign up for our newsletters',
            'this service is not intended for persons residing in the eu',
            'also worth reading',
            'related topics',
        )
        return any(p in lower for p in phrases)

    def default_cover(self, cover_file):
        now_sgt = datetime.now(SGT)
        day_name = now_sgt.strftime('%A').upper()
        date_line = now_sgt.strftime('%d %B %Y')
        full_date = now_sgt.strftime('%A, %d %B %Y')

        try:
            from PIL import Image, ImageDraw, ImageFont
            from calibre.utils.resources import get_path as P

            width, height = 1200, 1600
            img = Image.new('RGB', (width, height), '#FFFFFF')
            draw = ImageDraw.Draw(img)

            font_masthead = ImageFont.truetype(P('fonts/liberation/LiberationSans-Bold.ttf'), 72)
            font_edition = ImageFont.truetype(P('fonts/liberation/LiberationSans-Bold.ttf'), 30)
            font_day = ImageFont.truetype(P('fonts/liberation/LiberationSans-Bold.ttf'), 46)
            font_date = ImageFont.truetype(P('fonts/liberation/LiberationSerif-Bold.ttf'), 84)
            font_sections = ImageFont.truetype(P('fonts/liberation/LiberationSans-Regular.ttf'), 34)

            draw.rectangle([48, 48, width - 48, height - 48], outline='#111111', width=4)
            draw.rectangle([48, 48, width - 48, 280], fill='#111111')
            draw.text((width // 2, 164), 'CHANNEL NEWSASIA', fill='#FFFFFF', font=font_masthead, anchor='mm')

            draw.text((width // 2, 345), 'MORNING DIGEST  •  SINGAPORE', fill='#333333', font=font_edition, anchor='mm')
            draw.line([140, 395, width - 140, 395], fill='#111111', width=3)

            draw.text((width // 2, 690), day_name, fill='#444444', font=font_day, anchor='mm')
            draw.text((width // 2, 790), date_line, fill='#111111', font=font_date, anchor='mm')

            draw.line([140, 1340, width - 140, 1340], fill='#111111', width=3)
            draw.text(
                (width // 2, 1410),
                'World   •   Singapore   •   Business   •   Asia',
                fill='#222222',
                font=font_sections,
                anchor='mm',
            )

            img.save(cover_file, format='JPEG', quality=90)
            return True

        except Exception:
            from calibre.ebooks.covers import generate_cover
            data = generate_cover('Channel NewsAsia', authors=[full_date])
            cover_file.write(data)
            return True

    def preprocess_html(self, soup):
        headline = self._extract_headline(soup)

        hero_url = None
        og_img = soup.find('meta', property='og:image') or soup.find('meta', attrs={'name': 'twitter:image'})
        if og_img and og_img.get('content'):
            hero_url = self._clean_img_url(og_img['content'], is_srcset=False)

        for junk in soup.find_all(['script', 'style', 'noscript', 'iframe', 'svg', 'form']):
            junk.decompose()

        root = soup.find('main') or soup.find('article') or soup.body or soup
        self._normalize_media(root, soup)

        if not hero_url:
            first_img = root.find('img', src=True)
            if first_img:
                hero_url = first_img['src']

        # Build a clean HTML document so no hidden site CSS or readability filter can strip content
        clean_soup = self.index_to_soup('<html><head><meta charset="utf-8"/></head><body></body></html>')
        body = clean_soup.body

        if headline:
            h1_tag = clean_soup.new_tag('h1')
            h1_tag.string = headline
            body.append(h1_tag)

        seen_imgs = set()
        if hero_url:
            seen_imgs.add(hero_url)
            hero_p = clean_soup.new_tag('p')
            hero_p.append(clean_soup.new_tag('img', src=hero_url))
            body.append(hero_p)

        text_blocks = [
            div for div in root.find_all('div', class_=lambda c: c and 'text-long' in c)
            if not self._is_noise_block(div)
        ]
        if not text_blocks:
            text_blocks = [root]

        for block in text_blocks:
            for el in block.find_all(['p', 'h2', 'h3', 'h4', 'blockquote', 'ul', 'ol', 'img']):
                if el.find_parent(['blockquote', 'ul', 'ol']):
                    continue
                if el.name == 'img' and el.find_parent('p'):
                    continue
                if self._is_noise_block(el):
                    continue

                if el.name == 'img':
                    src = el.get('src')
                    if src and src not in seen_imgs:
                        seen_imgs.add(src)
                        p_img = clean_soup.new_tag('p')
                        p_img.append(clean_soup.new_tag('img', src=src))
                        body.append(p_img)
                    continue

                txt = ' '.join(el.get_text().split()).strip()
                imgs_inside = el.find_all('img', src=True)
                if not txt and not imgs_inside:
                    continue
                if txt and self._is_boilerplate_text(txt):
                    continue

                # Strip classes/inline styles so Kindle renders crisp native text and images
                for child in [el] + list(el.find_all(True)):
                    if child.name == 'img':
                        src = child.get('src')
                        if src and src not in seen_imgs:
                            seen_imgs.add(src)
                            child.attrs = {'src': src}
                        else:
                            child.decompose()
                    elif child.name == 'a':
                        href = child.get('
